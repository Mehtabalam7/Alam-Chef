
{
  "entities": {
    "Inquiry": {
      "title": "Inquiry",
      "description": "A contact inquiry from a potential client or partner.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Full name of the sender."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the sender."
        },
        "subject": {
          "type": "string",
          "description": "The topic of the inquiry."
        },
        "message": {
          "type": "string",
          "description": "The detailed message content."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the inquiry was sent."
        }
      },
      "required": [
        "name",
        "email",
        "message"
      ]
    }
  },
  "auth": {
    "providers": [
      "google.com"
    ]
  },
  "firestore": {
    "inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Collection of contact inquiries sent via the website."
    }
  }
}
